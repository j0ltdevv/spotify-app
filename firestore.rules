rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permettre à tout utilisateur connecté (même anonyme) de lire/écrire les parties
    // C'est nécessaire pour que les invités puissent rejoindre la partie de l'hôte
    match /games/{gameId} {
      allow read, write: if request.auth != null;
    }
    // Les profils utilisateurs restent privés ou lisibles par tous pour afficher les noms/avatars ?
    // Pour afficher les avatars des autres joueurs, il faut que 'users' soit lisible.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}