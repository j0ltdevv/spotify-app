# =================================
# TRACK ROULETTE BACKEND - CONFIG
# =================================

# Server
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Frontend URLs (CORS)
CLIENT_URL=http://localhost:19006
CLIENT_URL_PROD=https://your-app.com

# Database
MONGODB_URI=mongodb://localhost:27017/track-roulette
# Ou MongoDB Atlas : mongodb+srv://user:pass@cluster.mongodb.net/track-roulette

# Redis Cache
REDIS_URL=redis://localhost:6379
# Ou Redis Cloud : redis://default:password@redis-xxxxx.cloud.redislabs.com:12345

# JWT Secret (générer avec: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=7d

# Spotify OAuth
SPOTIFY_CLIENT_ID=3765c558e9704334bbe1acebe13998fa
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret-here
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/spotify/callback
SPOTIFY_REDIRECT_URI_PROD=https://your-backend.railway.app/api/auth/spotify/callback

# iTunes API (pas de clé requise)
ITUNES_API_URL=https://itunes.apple.com/search

# Deezer API (pas de clé requise)
DEEZER_API_URL=https://api.deezer.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Analytics (Optionnel)
SENTRY_DSN=
MIXPANEL_TOKEN=

# WebSocket
WS_PORT=3001
